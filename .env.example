# -----------------------------------------------------------------------------
# App Service Configuration
# -----------------------------------------------------------------------------
PORT=3200
NODE_ENV=production
SERVER_URL=http://localhost:3200

# -----------------------------------------------------------------------------
# Client-Side Environment Variables (Prefix with NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# Mock 数据源开关: "true" 启用 MSW 本地模拟数据，"false" 请求真实 API_URL
NEXT_PUBLIC_ENABLE_MOCK=true

# 后端接口服务基地址 (如: https://api.example.com)
NEXT_PUBLIC_API_URL=

# 高德地图 Web 服务 Key (用于坐标定位与逆地理编码)
NEXT_PUBLIC_AMAP_KEY=

# 天地图开发者 Token
NEXT_PUBLIC_TIANDITU_TOKEN=

# Centrifuge / WebSocket 实时推送服务地址
NEXT_PUBLIC_CENTRIFUGE_WS_URL=ws://localhost:8000/connection/websocket

# GlitchTip / Sentry 异常监控 DSN
NEXT_PUBLIC_GLITCHTIP_DSN=
