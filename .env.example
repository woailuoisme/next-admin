# -----------------------------------------------------------------------------
# 服务端运行配置 (Server Configuration)
# -----------------------------------------------------------------------------
PORT=3500
SERVER_URL=http://localhost:3500

# -----------------------------------------------------------------------------
# 客户端公共配置 (Client Configuration - 必须以 NEXT_PUBLIC_ 前缀)
# -----------------------------------------------------------------------------
# 应用基础信息
NEXT_PUBLIC_APP_TITLE=Admin Panel
NEXT_PUBLIC_APP_URL=http://localhost:3500

# Mock 数据源开关: true 启用本地模拟数据，false 请求真实后端接口
NEXT_PUBLIC_ENABLE_MOCK=true

# 后端实际 API 接口基地址 (为空时使用 Mock 拦截或相对路径 /v1)
NEXT_PUBLIC_API_URL=

# 地图与地理信息服务凭证 (高德地图 / 天地图，可于开放平台申请浏览器端 Key)
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_TIANDITU_TOKEN=

# 实时通信 WebSocket 服务 (Centrifuge)
NEXT_PUBLIC_CENTRIFUGE_WS_URL=ws://localhost:48000/connection/websocket
CENTRIFUGO_API_URL=http://localhost:48000/api
# 以下两项必须与 Centrifugo 服务端配置一致；生产环境请使用随机生成的独立值，勿沿用示例
CENTRIFUGO_HTTP_API_KEY=replace-with-centrifugo-api-key
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=replace-with-random-hmac-secret

# 前端异常监控 (GlitchTip / Sentry DSN)
NEXT_PUBLIC_GLITCHTIP_DSN=
