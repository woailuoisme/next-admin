{
  "mcpServers": {
    "ast-grep": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/ast-grep/ast-grep-mcp", "ast-grep-server"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@4.22.1", "mcp"]
    }
  }
}
