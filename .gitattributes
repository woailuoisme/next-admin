# 默认使用 LF 换行符
* text=auto eol=lf

# Windows 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本
*.sh text eol=lf

# Git 配置文件
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.editorconfig text eol=lf

# 常见文本文件
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary