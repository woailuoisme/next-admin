.env
.env.*
!.env.example
!.env.production

# Docs (not needed at build time)
README.md
api.md
AGENTS.md

# Debug and Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
*.log

# Docker and CI files
Dockerfile*
docker-compose*.yml
.dockerignore
