# Dependencies (在镜像内安装，绝不使用宿主机产物)
node_modules
.bun

# Next.js build output and caches
.next
out
build
dist
.output
*.tsbuildinfo

# Git, CI and agent surfaces
.git
.github
.gitignore
.agents
.cnb.yml
lefthook.yml
scratch

# IDE and Editor
.vscode
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Tests and coverage (源码目录名为 test/，需显式排除)
test
tests
__tests__
coverage
test-results
playwright-report
*.test.*
*.spec.*
vitest.config.ts

# Tool caches
.turbo
.rumdl_cache
.code-review-graph

# Environment files
